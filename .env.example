# Everything works without keys (Esri satellite imagery + keyless terrain).
# Optional upgrades, same as God's Eye View:

# Google Maps Platform key with the Map Tiles API enabled → Photorealistic 3D Tiles.
VITE_GOOGLE_MAPS_API_KEY=

# Cesium ion token → Cesium World Terrain, and Google 3D Tiles through ion.
VITE_CESIUM_ION_TOKEN=

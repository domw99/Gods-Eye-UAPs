{
  "name": "gods-eye-uap",
  "private": true,
  "version": "0.1.0",
  "description": "God's Eye // UAP — a 3D globe intelligence console for Unidentified Anomalous Phenomena: documented encounters, reconstructed flight paths, official government footage and files, and reference imagery.",
  "type": "module",
  "license": "MIT",
  "author": "domw99 (https://github.com/domw99)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/fix-cesium-base.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "sync:official": "node scripts/sync-dvids.mjs",
    "build:bluebook": "node scripts/build-bluebook.mjs",
    "build:nuforc": "node scripts/build-nuforc.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "data": "npm run sync:official && npm run build:bluebook && npm run build:nuforc && npm run build:airspace && npm run build:geipan && npm run build:mufon && npm run build:journals && npm run build:textindex && npm run verify:media",
    "build:airspace": "node scripts/build-airspace.mjs",
    "build:mufon": "node scripts/build-mufon.mjs",
    "build:geipan": "node scripts/build-geipan.mjs",
    "build:journals": "node scripts/build-journals.mjs",
    "build:textindex": "node scripts/build-textindex.mjs",
    "build:notices": "node scripts/build-notices.mjs",
    "build:changelog": "node scripts/build-changelog.mjs",
    "i18n:add": "node scripts/add-strings.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "astronomy-engine": "^2.1.19",
    "cesium": "^1.145.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "vite": "^6.4.3",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^5.0.3"
  }
}
